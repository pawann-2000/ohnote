{
  "manifest_version": 3,
  "name": "OhNote — Open notebooks anywhere",
  "version": "0.0.1",
  "description": "Right-click any Colab or GitHub .ipynb link to open it in Kaggle, Deepnote, SageMaker, Binder, vscode.dev, and more.",
  "author": "OhNote",
  "homepage_url": "https://github.com/",
  "minimum_chrome_version": "114",
  "permissions": ["contextMenus", "storage", "tabs"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OhNote — open this notebook in…",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
